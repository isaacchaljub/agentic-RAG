# Template for LOCAL runs only. Copy to `.env` and fill in real keys:
#   cp .env.example .env
# Then run the container with:  docker run --env-file .env ...
#
# IMPORTANT: `.env` is git-ignored AND docker-ignored — it never enters the image.
# In the cloud you set these as managed secrets/env vars (AWS/Azure), NOT a file.

GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
SERPER_API_KEY=your_serper_api_key_here
